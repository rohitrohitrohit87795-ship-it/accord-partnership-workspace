PORT=4000
HOST=127.0.0.1
# All partnership actions are signed on the local blockchain.
APP_MODE=chain
# Set a long random secret before sharing the app with others.
JWT_SECRET=
# Local MongoDB server; open this connection in MongoDB Compass.
MONGODB_URI=mongodb://127.0.0.1:27017/accord
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# npm run deploy writes data/chain.json; an explicit address overrides it.
FACTORY_ADDRESS=
